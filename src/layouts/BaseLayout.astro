---
import { siteConfig } from '../../site.config.mjs';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import '../styles/global.css';

const {
  title = siteConfig.name,
  description = siteConfig.description,
  image = siteConfig.defaultOgImage,
  type = 'website',
  noindex = false,
  canonical,
} = Astro.props;
const pageTitle = title === siteConfig.name ? title : `${title} | ${siteConfig.name}`;
const canonicalUrl = canonical || new URL(Astro.url.pathname, siteConfig.url).toString();
const imageUrl = image.startsWith('http') ? image : new URL(image, siteConfig.url).toString();
const shouldNoindex = noindex || Astro.props.noindex === true;
const safeJson = (value) => JSON.stringify(value).replace(/</g, '\\u003c');
---
<!doctype html>
<html lang={siteConfig.language}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <meta name="theme-color" content={siteConfig.brandColor} />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />
    {siteConfig.googleSiteVerification && <meta name="google-site-verification" content={siteConfig.googleSiteVerification} />}
    {shouldNoindex && <meta name="robots" content="noindex,follow" />}
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="alternate" type="application/rss+xml" title={`${siteConfig.name} RSS`} href="/rss.xml" />
    <meta property="og:type" content={type} />
    <meta property="og:site_name" content={siteConfig.name} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={imageUrl} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={imageUrl} />
    <script type="application/ld+json" set:html={safeJson({
      '@context': 'https://schema.org',
      '@type': 'WebSite',
      name: siteConfig.name,
      url: siteConfig.url,
      description: siteConfig.description,
      inLanguage: siteConfig.language,
      publisher: { '@type': 'Organization', name: siteConfig.name, url: siteConfig.url },
    })}></script>
    <script type="application/ld+json" set:html={safeJson({
      '@context': 'https://schema.org',
      '@type': 'Organization',
      name: siteConfig.name,
      url: siteConfig.url,
      logo: new URL('/favicon.svg', siteConfig.url).toString(),
      email: siteConfig.email || undefined,
      founder: { '@type': 'Person', name: siteConfig.author, description: siteConfig.authorBio },
    })}></script>
    <script type="application/ld+json" set:html={safeJson({
      '@context': 'https://schema.org',
      '@type': 'Person',
      name: siteConfig.author,
      description: siteConfig.authorBio,
      url: new URL('/about/', siteConfig.url).toString(),
    })}></script>
    <script is:inline>
      (() => {
        const viewport = window.matchMedia('(max-width: 767px)');
        let domReady = document.readyState !== 'loading';
        let advertisingConsent = false;
        let busy = false;
        let activateAgain = false;

        const hasAdvertisingConsent = (detail) => {
          if (!detail) return false;
          const categories = detail.categories || {};
          const accepted = Array.isArray(detail.accepted) ? detail.accepted : [];
          const granted = categories.advertisement === true || accepted.includes('advertisement');
          const activeLaw = String(detail.activeLaw || '').toLowerCase();
          if (activeLaw === 'gdpr' && detail.isUserActionCompleted !== true) return false;
          return granted;
        };

        const injectRentSmartAdMarkup = async (container, code) => {
          const template = document.createElement('template');
          template.innerHTML = code;
          const nodes = Array.from(template.content.childNodes);

          // Place non-script elements first so native units can find their target containers.
          for (const node of nodes) {
            if (!(node.nodeType === Node.ELEMENT_NODE && node.tagName === 'SCRIPT')) {
              container.appendChild(node.cloneNode(true));
            }
          }

          // Recreate script tags in source order. Await external scripts so each atOptions
          // configuration is read before another unit can overwrite the shared global.
          for (const node of nodes) {
            if (!advertisingConsent) break;
            if (!(node.nodeType === Node.ELEMENT_NODE && node.tagName === 'SCRIPT')) continue;
            const script = document.createElement('script');
            for (const attribute of Array.from(node.attributes)) {
              script.setAttribute(attribute.name, attribute.value);
            }
            script.textContent = node.textContent || '';

            if (node.hasAttribute('src')) {
              if (!node.hasAttribute('async')) script.async = false;
              await new Promise((resolve) => {
                let settled = false;
                const finish = () => {
                  if (settled) return;
                  settled = true;
                  resolve();
                };
                script.addEventListener('load', finish, { once: true });
                script.addEventListener('error', finish, { once: true });
                container.appendChild(script);
              });
            } else {
              container.appendChild(script);
            }
          }
        };

        const activateRentSmartAds = async () => {
          if (!domReady || !advertisingConsent) return;
          if (busy) {
            activateAgain = true;
            return;
          }
          busy = true;
          do {
            activateAgain = false;
            const mobile = viewport.matches;
            const creatives = Array.from(document.querySelectorAll('.ad-slot__creative[data-ad-code]'));
            for (const creative of creatives) {
              if (!advertisingConsent) break;
              if (creative.dataset.adLoaded === 'true' || creative.dataset.adLoaded === 'loading') continue;
              const slot = creative.closest('.ad-slot');
              if (!slot) continue;
              if (slot.classList.contains('ad-slot--desktop-only') && mobile) continue;
              if (slot.classList.contains('ad-slot--mobile-only') && !mobile) continue;
              const code = creative.getAttribute('data-ad-code') || '';
              if (!code.trim() || code.includes('PASTE_ADSTERRA_CODE_HERE')) continue;

              creative.dataset.adLoaded = 'loading';
              try {
                await injectRentSmartAdMarkup(creative, code);
                if (advertisingConsent) creative.dataset.adLoaded = 'true';
                else {
                  creative.replaceChildren();
                  creative.dataset.adLoaded = 'revoked';
                }
              } catch {
                creative.replaceChildren();
                creative.dataset.adLoaded = 'error';
              }
            }
          } while (activateAgain && advertisingConsent);
          busy = false;
        };

        const updateRentSmartAdConsent = (event) => {
          advertisingConsent = hasAdvertisingConsent(event && event.detail);
          if (advertisingConsent) {
            activateRentSmartAds();
          } else {
            document.querySelectorAll('.ad-slot__creative[data-ad-loaded="true"], .ad-slot__creative[data-ad-loaded="loading"]').forEach((creative) => {
              creative.replaceChildren();
              creative.dataset.adLoaded = 'revoked';
            });
          }
        };

        document.addEventListener('cookieyes_banner_load', updateRentSmartAdConsent);
        document.addEventListener('cookieyes_consent_update', updateRentSmartAdConsent);
        if (document.readyState === 'loading') {
          document.addEventListener('DOMContentLoaded', () => {
            domReady = true;
            activateRentSmartAds();
          }, { once: true });
        } else {
          domReady = true;
          activateRentSmartAds();
        }
        if (typeof viewport.addEventListener === 'function') viewport.addEventListener('change', activateRentSmartAds);
        else viewport.addListener(activateRentSmartAds);
      })();
    </script>
    <script id="cookieyes" type="text/javascript" src="https://cdn-cookieyes.com/client_data/0251b4780db20441fc232356/script.js"></script>
    {siteConfig.googleAnalyticsId && (
      <>
        <script async src={`https://www.googletagmanager.com/gtag/js?id=${siteConfig.googleAnalyticsId}`}></script>
        <script is:inline data-ga-id={siteConfig.googleAnalyticsId}>
          const analyticsId = document.currentScript?.getAttribute('data-ga-id');
          window.dataLayer = window.dataLayer || [];
          function gtag(){window.dataLayer.push(arguments);}
          gtag('js', new Date());
          gtag('config', analyticsId);
        </script>
      </>
    )}
    {siteConfig.adsensePublisherId && (
      <script async src={`https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=${siteConfig.adsensePublisherId}`} crossorigin="anonymous"></script>
    )}
    <slot name="head" />
  </head>
  <body style={`--brand: ${siteConfig.brandColor}; --accent: ${siteConfig.accentColor}; --highlight: ${siteConfig.highlightColor};`}>
    <a class="skip-link" href="#main">Skip to content</a>
    <SiteHeader />
    <main id="main"><slot /></main>
    <SiteFooter />
  </body>
</html>
