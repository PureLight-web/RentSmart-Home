---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout title="Page not found" description="The page you are looking for could not be found." noindex={true}>
  <section class="page-hero"><div class="container"><p class="section-kicker">Error 404</p><h1>This page took a wrong turn.</h1><p>The address may have changed, or the page may no longer exist. Try a search or head back to the homepage.</p><div class="hero-actions"><a class="button button-primary" href="/">Back to home ↗</a><a class="button" style="background:var(--ink);color:#fff" href="/search/">Search articles</a></div></div></section>
</BaseLayout>
