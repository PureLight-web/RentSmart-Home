---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ArticleCard from '../../components/ArticleCard.astro';
import { getCollection, render } from 'astro:content';
import { siteConfig } from '../../../site.config.mjs';
import { absoluteUrl, formatDate, slugify } from '../../lib/site';

export async function getStaticPaths() {
  const articles = await getCollection('articles', ({ data }) => !data.draft);
  return articles.map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}
const { entry } = Astro.props;
const { Content, headings } = await render(entry);
const { data } = entry;
const authorName = data.author || siteConfig.author;
const allArticles = await getCollection('articles', ({ data }) => !data.draft && data.category === entry.data.category && data.title !== entry.data.title);
const related = allArticles.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()).slice(0, 3);
const canonical = absoluteUrl(`/articles/${entry.id}/`, siteConfig.url);
const socialImage = data.heroImage ? (data.heroImage.startsWith('http') ? data.heroImage : absoluteUrl(data.heroImage, siteConfig.url)) : absoluteUrl(siteConfig.defaultOgImage, siteConfig.url);
const safeJson = (value) => JSON.stringify(value).replace(/</g, '\\u003c');
const articleSchema = {
  '@context': 'https://schema.org', '@type': 'Article', headline: data.title,
  description: data.description, datePublished: data.pubDate.toISOString(),
  dateModified: (data.updatedDate || data.pubDate).toISOString(), mainEntityOfPage: canonical,
  author: { '@type': authorName.toLowerCase().includes('team') ? 'Organization' : 'Person', name: authorName }, publisher: { '@type': 'Organization', name: siteConfig.name, url: siteConfig.url },
  image: socialImage, articleSection: data.category, inLanguage: siteConfig.language,
};
---
<BaseLayout title={data.seoTitle || data.title} description={data.description} canonical={canonical} image={data.heroImage || siteConfig.defaultOgImage} type="article" noindex={data.noindex}>
  <Fragment slot="head"><script type="application/ld+json" set:html={safeJson(articleSchema)}></script><script type="application/ld+json" set:html={safeJson({ '@context': 'https://schema.org', '@type': 'BreadcrumbList', itemListElement: [ { '@type': 'ListItem', position: 1, name: siteConfig.name, item: siteConfig.url }, { '@type': 'ListItem', position: 2, name: data.category, item: absoluteUrl(`/category/${slugify(data.category)}/`, siteConfig.url) }, { '@type': 'ListItem', position: 3, name: data.title, item: canonical } ] })}></script></Fragment>
  <section class="container content-section">
    <div class="breadcrumbs"><a href="/">Home</a><span>›</span><a href="/topics/">Topics</a><span>›</span><a href={`/category/${slugify(data.category)}/`}>{data.category}</a></div>
    <div class="article-layout">
      <article>
        <header class="article-header">
          <div class="article-meta"><a href={`/category/${slugify(data.category)}/`}>{data.category}</a><span aria-hidden="true">·</span><time datetime={data.pubDate.toISOString()}>{formatDate(data.pubDate)}</time></div>
          <h1>{data.title}</h1>
          <p class="article-deck">{data.description}</p>
          <div class="article-byline"><span>By <strong>{authorName}</strong></span>{data.updatedDate && <><span aria-hidden="true">·</span><span>Updated {formatDate(data.updatedDate)}</span></>}</div>
        </header>
        {data.heroImage && <img class="article-cover" src={data.heroImage} alt={data.heroImageAlt || ''} fetchpriority="high" />}
        <div class="prose article-prose"><Content /></div>
        {data.tags?.length > 0 && <div class="tag-list" aria-label="Article tags">{data.tags.map((tag) => <span class="tag">{tag}</span>)}</div>}
        <div class="article-end"><strong>Want to explore further?</strong><p>Read more explainers in {data.category}, or learn how this site approaches research and corrections.</p><a class="text-link" href={`/category/${slugify(data.category)}/`}>More in {data.category} <span aria-hidden="true">→</span></a></div>
      </article>
      <aside class="article-sidebar" aria-label="Related information">
        <div class="side-card"><h2>In this article</h2>{headings.length ? <nav>{headings.filter((heading) => heading.depth === 2).map((heading) => <p><a href={`#${heading.slug}`}>{heading.text}</a></p>)}</nav> : <p>Use the headings to navigate this guide.</p>}</div>
        <div class="side-card"><h2>Our approach</h2><p>We aim to separate established facts from interpretation, explain important limits, and link readers to useful primary sources.</p><p style="margin-top:12px"><a href="/editorial-policy/">Read our editorial policy →</a></p></div>
        <div class="side-card"><h2>Corrections?</h2><p>Found an error or a source that needs updating? Let our editors know.</p><p style="margin-top:12px"><a href="/sources/">Sources &amp; corrections →</a></p></div>
      </aside>
    </div>
  </section>
  {related.length > 0 && (<section class="container section-tight"><div class="section-head"><div><p class="section-kicker">Keep exploring</p><h2 class="section-title">Related reads</h2></div></div><div class="article-grid">{related.map((article) => <ArticleCard article={article} />)}</div></section>)}
</BaseLayout>
