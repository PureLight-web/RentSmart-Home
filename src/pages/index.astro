---
import BaseLayout from '../layouts/BaseLayout.astro';
import ArticleCard from '../components/ArticleCard.astro';
import { getCollection } from 'astro:content';
import { siteConfig } from '../../site.config.mjs';
import { slugify } from '../lib/site';
import AdSlot from '../components/AdSlot.astro';
const articles=(await getCollection('articles',({data})=>!data.draft&&!data.noindex)).sort((a,b)=>b.data.pubDate.valueOf()-a.data.pubDate.valueOf());
const featured=articles.find(a=>a.data.featured)||articles[0];
const latest=articles.filter(a=>a.id!==featured?.id).slice(0,6);
const groups=[
 ['Renter-Friendly Upgrades','Personalise a rental without making a permanent commitment.','⌂'],
 ['Walls, Floors & Storage','No-drill shelves, removable finishes and small-space storage.','↗'],
 ['Move-In & Move-Out','Document the condition and prepare for a clean handover.','✓'],
 ['Lighting & Smart Home','Add convenient lighting and connected devices without rewiring.','◈']
];
---
<BaseLayout title={siteConfig.name} description={siteConfig.description}>
<section class="container hero"><div class="hero-inner"><div class="hero-copy"><div class="eyebrow"><span class="dot"></span> More comfort, less commitment</div><h1>{siteConfig.tagline}</h1><p>Make a rental feel considered, organised and personal—without ignoring your lease, your surfaces, or your deposit. Start with practical projects, honest cost ranges, and a plan for removal.</p><div class="hero-actions"><a class="button button-primary" href="/topics/">Explore renter-friendly guides ↗</a><a class="button button-ghost" href="/articles/complete-guide-renter-friendly-home-upgrades/">Start with the upgrade guide</a></div></div><div class="hero-art" aria-hidden="true"><div class="orb"></div><div class="floating-card float-one">Designed for rental living<small>Flexible · Budget-aware · Reversible</small></div><div class="floating-card float-two">Small changes, planned well<div class="mini-bars"><i></i><i></i><i></i><i></i></div></div></div></div></section>
<AdSlot slot="native-banner" placement="homepage-after-hero" />
<section class="container section"><div class="section-head"><div><p class="section-kicker">Start with a good plan</p><h2 class="section-title">The renter-friendly upgrade playbook</h2><p class="section-intro">Before buying anything, check the lease, surface condition, product instructions and the route back to move-out day. A “removable” label is not a damage-free guarantee.</p></div></div>{featured?<div class="article-grid"><ArticleCard article={featured}/></div>:<div class="empty-state"><strong>Our first guides are being prepared.</strong>New renter guides will appear here as they are published.</div>}</section>
<section class="container section-tight"><div class="section-head"><div><p class="section-kicker">Browse by need</p><h2 class="section-title">Practical guides for real rentals</h2><p class="section-intro">Every project aims to include cost context, a reversibility score, mistakes to avoid and a checklist.</p></div><a class="text-link" href="/topics/">All topics →</a></div><div class="topic-grid">{groups.map(([title,desc,icon])=><a class="topic-card" href={`/category/${slugify(title)}/`}><span class="topic-icon" aria-hidden="true">{icon}</span><h3>{title}</h3><p>{desc}</p></a>)}<a class="topic-card" href="/tenancy-rules/us/"><span class="topic-icon">US</span><h3>US renter rules</h3><p>Start with your lease and state/local guidance.</p></a><a class="topic-card" href="/tenancy-rules/uk/"><span class="topic-icon">UK</span><h3>England renter rules</h3><p>Find official tenancy and deposit resources for England.</p></a></div></section>
<AdSlot slot="banner-300x250" placement="homepage-mid-page" />
<section class="container section-tight"><div class="section-head"><div><p class="section-kicker">Keep exploring</p><h2 class="section-title">Latest guides</h2></div><a class="text-link" href="/search/">Search all articles →</a></div>{latest.length?<div class="article-grid">{latest.map(a=><ArticleCard article={a}/>)}</div>:<p class="section-intro">More articles will appear here as the library grows.</p>}</section>
<AdSlot slot="banner-728x90" placement="homepage-leaderboard" />
<AdSlot slot="banner-320x50" placement="homepage-mobile-banner" />
<section class="container section"><div class="split-cta"><div><h2>Reversibility first. Deposit surprises last.</h2><p>The 1–5 reversibility score is a planning aid, not a promise. Surface condition, humidity, product age, installation and removal technique can change the result.</p></div><a class="button" href="/articles/move-in-condition-checklist-protect-deposit/">Protect your deposit ↗</a></div></section>
</BaseLayout>
